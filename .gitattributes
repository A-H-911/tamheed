# Canonical package text is byte-defined (db/CANONICAL.md): store.dump writes LF,
# and check.py's canonical-form gate compares raw bytes — so *.jsonl must check out
# LF on every platform, or a fresh Windows clone fails the gate on line endings.
*.jsonl text eol=lf

# The user guide is generated with LF (docs/guide/build.py); the byte-twin test compares raw bytes.
/index.html text eol=lf

# The per-item figures are generated with LF too (plan 203); the byte-twin covers the folder.
docs/guide/figures/*.svg text eol=lf
